{
    "name": "gokure/hyperf-cors",
    "description": "Adds CORS (Cross-Origin Resource Sharing) headers support in your Hyperf application.",
    "keywords": ["hyperf", "cors"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Gang Wu",
            "email": "gokure@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hyperf/di": "~3.2.0",
        "hyperf/http-server": "~3.2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.63",
        "hyperf/config": "~3.2.0",
        "hyperf/testing": "~3.2.0",
        "hyperf/validation": "~3.2.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Gokure\\HyperfCors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gokure\\HyperfCors\\Tests\\": "tests/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Gokure\\HyperfCors\\ConfigProvider"
        },
        "branch-alias": {
            "dev-master": "3.2-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "./vendor/bin/co-phpunit --colors=always",
        "cs-fix": "./vendor/bin/php-cs-fixer fix $1",
        "analyse": "phpstan analyse --memory-limit 300M -l 0 -c phpstan.neon ./src ./tests"
    }
}
